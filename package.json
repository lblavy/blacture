{
  "name": "blacture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.12.0",
    "npm": "^11.6.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && node --test tests/e2e/*.spec.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src tests eslint.config.mjs vite.config.ts",
    "format:check": "prettier --check \"*.{json,mjs,ts,html}\" \".{jscpd,prettierrc}.json\" \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\"",
    "duplication": "jscpd --format typescript --fail-on-empty src && jscpd --format css --fail-on-empty src && jscpd --format markup --fail-on-empty index.html",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run coverage && npm run duplication",
    "quality:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.3",
    "fake-indexeddb": "6.2.8",
    "jscpd": "5.4.3",
    "jsdom": "29.1.1",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "hast-util-to-html": "9.0.7",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  }
}
